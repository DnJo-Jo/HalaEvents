  "riskCategories": [
    {
      "key": "venue",
      "label": "Room and equipment",
      "description": "The room is unavailable or equipment fails.",
      "when": [
        {
          "key": "event.venue_type",
          "op": "not_in",
          "values": ["online"]
        }
      ],
      "mitigation": "Confirm the room and test equipment before participants arrive.",
      "contingency": "Keep a printed copy of the materials and a spare device.",
      "likelihood": "medium",
      "elevatedWhen": [
        {
          "key": "venue.status",
          "op": "in",
          "values": ["requested", "not_started"]
        }
      ]
    },
    {
      "key": "facilitator",
      "label": "Facilitator unavailable",
      "description": "The facilitator falls ill or cancels.",
      "when": [],
      "mitigation": "Share the plan and materials with a second person.",
      "contingency": "Agree a backup facilitator or a reschedule date.",
      "likelihood": "low",
      "elevatedWhen": [
        {
          "key": "facilitators.count",
          "op": "equals",
          "value": 1
        }
      ]
    },
    {
      "key": "minors",
      "label": "Participants under 18",
      "description": "Consent and supervision.",
      "when": [
        {
          "key": "audience.minors",
          "op": "equals",
          "value": true
        }
      ],
      "mitigation": "Collect guardian consent and name a supervisor.",
      "contingency": "Do not admit a minor without consent.",
      "likelihood": "medium",
      "elevatedWhen": []
    },
    {
      "key": "technology",
      "label": "Devices and connectivity",
      "description": "Participants' devices, accounts or Wi-Fi fail.",
      "when": [
        {
          "key": "materials.needed",
          "op": "includes",
          "value": "laptops"
        }
      ],
      "mitigation": "Ask participants to test their set-up before the day.",
      "contingency": "Have spare devices and offline copies of the materials.",
      "likelihood": "medium",
      "elevatedWhen": [
        {
          "key": "materials.needed",
          "op": "includes",
          "value": "software"
        }
      ]
    },
    {
      "key": "pace",
      "label": "Pace does not suit the group",
      "description": "The content is too hard or too easy.",
      "when": [],
      "mitigation": "Ask about experience at registration.",
      "contingency": "Prepare an extension exercise and a simpler version.",
      "likelihood": "medium",
      "elevatedWhen": [
        {
          "key": "learners.level",
          "op": "equals",
          "value": "mixed"
        }
      ]
    },
    {
      "key": "food",
      "label": "Food safety and dietary needs",
      "description": "Allergies and dietary requirements.",
      "when": [
        {
          "key": "catering.provided",
          "op": "equals",
          "value": true
        }
      ],
      "mitigation": "Ask about dietary needs at registration.",
      "contingency": "Keep simple allergen-free options.",
      "likelihood": "low",
      "elevatedWhen": [
        {
          "key": "catering.dietary",
          "op": "includes",
          "value": "nut_free"
        }
      ]
    }
  ],
