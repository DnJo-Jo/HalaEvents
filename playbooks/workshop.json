{
  "$comment": "HalaEvents playbook for workshops and training sessions. Validated by PlaybookSchema (src/modules/planning/playbook.ts). Text is planning guidance written by the HalaEvents team, not legal advice or verified sources; budget amounts are illustrative allowances, not quotes.",
  "id": "workshop",
  "version": 1,
  "eventType": "workshop",
  "title": "Workshop or training session",
  "referenceCurrency": "AED",
  "summary": "{{event.name}} is a workshop lasting {{event.duration_hours}} for about {{event.capacity}} participants (level: {{learners.level}}; format: {{session.format}}; {{facilitators.count}} facilitating; city: {{event.city}}).",
  "questions": [
    {
      "key": "learners.level",
      "type": "single_choice",
      "text": "What level are the participants?",
      "why": "Sets the pace, prerequisites and the materials you prepare.",
      "required": true,
      "when": [],
      "options": [
        {
          "value": "beginner",
          "label": "Beginners"
        },
        {
          "value": "intermediate",
          "label": "Some experience"
        },
        {
          "value": "advanced",
          "label": "Advanced"
        },
        {
          "value": "mixed",
          "label": "Mixed levels"
        }
      ]
    },
    {
      "key": "session.format",
      "type": "single_choice",
      "text": "What is the main format?",
      "why": "Decides the room set-up, equipment and group size.",
      "required": true,
      "when": [],
      "options": [
        {
          "value": "lecture",
          "label": "Mostly presentation"
        },
        {
          "value": "hands_on",
          "label": "Mostly hands-on practice"
        },
        {
          "value": "mixed",
          "label": "Presentation and practice"
        }
      ]
    },
    {
      "key": "facilitators.count",
      "type": "number",
      "text": "How many facilitators or trainers?",
      "why": "Sets facilitator costs and the participant-to-trainer ratio.",
      "required": true,
      "when": [],
      "min": 1,
      "max": 20,
      "unit": "people"
    },
    {
      "key": "audience.minors",
      "type": "boolean",
      "text": "Will anyone under 18 take part?",
      "why": "Adds guardian consent and supervision tasks.",
      "required": true,
      "when": []
    },
    {
      "key": "venue.status",
      "type": "single_choice",
      "text": "Where does the venue booking stand?",
      "why": "Decides how urgent the venue tasks are.",
      "required": true,
      "when": [
        {
          "key": "event.venue_type",
          "op": "not_in",
          "values": ["online"]
        }
      ],
      "options": [
        {
          "value": "confirmed_in_writing",
          "label": "Confirmed in writing"
        },
        {
          "value": "requested",
          "label": "Requested, not confirmed"
        },
        {
          "value": "not_started",
          "label": "Not started"
        }
      ]
    },
    {
      "key": "online.platform",
      "type": "text",
      "text": "Which online platform will you use?",
      "why": "Used to plan the technical test.",
      "required": false,
      "when": [
        {
          "key": "event.venue_type",
          "op": "in",
          "values": ["online", "hybrid"]
        }
      ],
      "maxLength": 100
    },
    {
      "key": "materials.needed",
      "type": "multi_choice",
      "text": "What do participants need?",
      "why": "Goes into the preparation and budget.",
      "required": false,
      "when": [],
      "options": [
        {
          "value": "handouts",
          "label": "Printed handouts"
        },
        {
          "value": "laptops",
          "label": "Laptops or devices"
        },
        {
          "value": "equipment",
          "label": "Special equipment"
        },
        {
          "value": "software",
          "label": "Software or accounts"
        }
      ]
    },
    {
      "key": "prerequisites.required",
      "type": "boolean",
      "text": "Must participants prepare anything beforehand?",
      "why": "Adds a preparation email and a deadline.",
      "required": true,
      "when": []
    },
    {
      "key": "registration.fee",
      "type": "boolean",
      "text": "Is there a participation fee?",
      "why": "Adds payment and refund tasks.",
      "required": true,
      "when": []
    },
    {
      "key": "catering.provided",
      "type": "boolean",
      "text": "Will you provide food or refreshments?",
      "why": "Adds catering tasks and budget lines.",
      "required": true,
      "when": []
    },
    {
      "key": "catering.dietary",
      "type": "multi_choice",
      "text": "Which dietary needs must refreshments cover?",
      "why": "Goes into the catering brief.",
      "required": false,
      "when": [
        {
          "key": "catering.provided",
          "op": "equals",
          "value": true
        }
      ],
      "options": [
        {
          "value": "halal",
          "label": "Halal"
        },
        {
          "value": "vegetarian",
          "label": "Vegetarian"
        },
        {
          "value": "vegan",
          "label": "Vegan"
        },
        {
          "value": "gluten_free",
          "label": "Gluten free"
        },
        {
          "value": "nut_free",
          "label": "Nut free"
        }
      ]
    },
    {
      "key": "certificate.issued",
      "type": "boolean",
      "text": "Will participants receive a certificate?",
      "why": "Adds certificate design and attendance tracking.",
      "required": true,
      "when": []
    },
    {
      "key": "feedback.collect",
      "type": "boolean",
      "text": "Will you collect feedback afterwards?",
      "why": "Adds a feedback survey task.",
      "required": true,
      "when": []
    },
    {
      "key": "accessibility.ask_needs",
      "type": "boolean",
      "text": "Will you ask participants about accessibility needs?",
      "why": "Adds an accessibility support task.",
      "required": true,
      "when": []
    }
  ],
  "goals": [
    {
      "text": "Teach the planned skills so participants leave able to use them."
    },
    {
      "text": "Keep the group size and pace suited to a {{learners.level}} level."
    },
    {
      "text": "Make hands-on time work: every participant has what they need.",
      "when": [
        {
          "key": "session.format",
          "op": "in",
          "values": ["hands_on", "mixed"]
        }
      ]
    },
    {
      "text": "Keep participants under 18 safe, with guardian consent.",
      "when": [
        {
          "key": "audience.minors",
          "op": "equals",
          "value": true
        }
      ]
    }
  ],
  "requirements": [
    {
      "text": "A room for about {{event.capacity}} people set up for {{session.format}}.",
      "when": [
        {
          "key": "event.venue_type",
          "op": "not_in",
          "values": ["online"]
        }
      ]
    },
    {
      "text": "A tested online platform with breakout rooms or chat.",
      "when": [
        {
          "key": "event.venue_type",
          "op": "in",
          "values": ["online", "hybrid"]
        }
      ]
    },
    {
      "text": "Devices and accounts for every participant before the day.",
      "when": [
        {
          "key": "materials.needed",
          "op": "includes",
          "value": "laptops"
        }
      ]
    },
    {
      "text": "Printed handouts or a shared folder with the materials.",
      "when": [
        {
          "key": "materials.needed",
          "op": "includes",
          "value": "handouts"
        }
      ]
    },
    {
      "text": "Guardian consent for participants under 18.",
      "when": [
        {
          "key": "audience.minors",
          "op": "equals",
          "value": true
        }
      ]
    },
    {
      "text": "Refreshments covering: {{catering.dietary}}.",
      "when": [
        {
          "key": "catering.provided",
          "op": "equals",
          "value": true
        }
      ]
    },
    {
      "text": "Attendance records for the certificate.",
      "when": [
        {
          "key": "certificate.issued",
          "op": "equals",
          "value": true
        }
      ]
    }
  ],
  "assumptions": [
    {
      "text": "Participants have mixed experience.",
      "ifMissing": "learners.level"
    },
    {
      "text": "The workshop mixes presentation and practice.",
      "ifMissing": "session.format"
    },
    {
      "text": "One facilitator leads the session.",
      "ifMissing": "facilitators.count"
    },
    {
      "text": "No participants are under 18.",
      "ifMissing": "audience.minors"
    }
  ],
  "decisions": [
    {
      "text": "Choose the learning outcomes for the session."
    },
    {
      "text": "Decide whether to charge a fee.",
      "ifMissing": "registration.fee"
    },
    {
      "text": "Decide whether participants receive a certificate.",
      "ifMissing": "certificate.issued"
    }
  ],
  "budgetLines": [
    {
      "key": "venue",
      "name": "Room hire",
      "basis": "fixed",
      "unitAmount": 1500,
      "note": "",
      "when": [
        {
          "key": "event.venue_type",
          "op": "not_in",
          "values": ["online"]
        }
      ]
    },
    {
      "key": "facilitators",
      "name": "Facilitator fees",
      "basis": "fixed",
      "unitAmount": 1500,
      "note": "Per facilitator.",
      "when": [],
      "adjustments": [
        {
          "when": [
            {
              "key": "facilitators.count",
              "op": "gte",
              "value": 2
            }
          ],
          "multiplier": 2
        },
        {
          "when": [
            {
              "key": "facilitators.count",
              "op": "gte",
              "value": 3
            }
          ],
          "multiplier": 1.5
        }
      ]
    },
    {
      "key": "materials",
      "name": "Materials",
      "basis": "per_attendee",
      "unitAmount": 25,
      "note": "Handouts and supplies.",
      "when": [
        {
          "key": "materials.needed",
          "op": "includes",
          "value": "handouts"
        }
      ]
    },
    {
      "key": "equipment",
      "name": "Equipment",
      "basis": "fixed",
      "unitAmount": 1200,
      "note": "",
      "when": [
        {
          "key": "materials.needed",
          "op": "includes",
          "value": "equipment"
        }
      ]
    },
    {
      "key": "platform",
      "name": "Online platform",
      "basis": "fixed",
      "unitAmount": 300,
      "note": "",
      "when": [
        {
          "key": "event.venue_type",
          "op": "in",
          "values": ["online", "hybrid"]
        }
      ]
    },
    {
      "key": "catering",
      "name": "Refreshments",
      "basis": "per_attendee",
      "unitAmount": 35,
      "note": "",
      "when": [
        {
          "key": "catering.provided",
          "op": "equals",
          "value": true
        }
      ]
    },
    {
      "key": "certificates",
      "name": "Certificates",
      "basis": "per_attendee",
      "unitAmount": 5,
      "note": "",
      "when": [
        {
          "key": "certificate.issued",
          "op": "equals",
          "value": true
        }
      ]
    },
    {
      "key": "reserve",
      "name": "Reserve",
      "basis": "fixed",
      "unitAmount": 500,
      "note": "For costs nobody planned for.",
      "when": []
    }
  ],
