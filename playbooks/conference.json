{
  "$comment": "HalaEvents playbook for conferences and seminars. Validated by PlaybookSchema (src/modules/planning/playbook.ts). Text is planning guidance written by the HalaEvents team, not legal advice or verified sources; budget amounts are illustrative allowances, not quotes.",
  "id": "conference",
  "version": 1,
  "eventType": "conference",
  "title": "Conference or seminar",
  "referenceCurrency": "AED",
  "summary": "{{event.name}} is a conference lasting {{event.duration_hours}} for about {{event.capacity}} attendees ({{program.tracks}}; audience: {{audience.kind}}; city: {{event.city}}).",
  "questions": [
    {
      "key": "audience.kind",
      "type": "single_choice",
      "text": "Who is the conference for?",
      "why": "Decides the invitation list, tone, ticketing and whether public-event checks apply.",
      "required": true,
      "when": [],
      "options": [
        {
          "value": "students",
          "label": "Students"
        },
        {
          "value": "professionals",
          "label": "Industry professionals"
        },
        {
          "value": "mixed",
          "label": "A mixed audience"
        },
        {
          "value": "public",
          "label": "Open to the public"
        }
      ]
    },
    {
      "key": "program.tracks",
      "type": "number",
      "text": "How many parallel tracks or rooms will run at once?",
      "why": "Sets the number of rooms, chairs, volunteers and AV set-ups.",
      "required": true,
      "when": [],
      "min": 1,
      "max": 12,
      "unit": "tracks"
    },
    {
      "key": "program.speakers",
      "type": "number",
      "text": "How many speakers do you expect?",
      "why": "Drives the call for speakers, speaker care and the agenda length.",
      "required": true,
      "when": [],
      "min": 0,
      "max": 200,
      "unit": "speakers"
    },
    {
      "key": "program.keynote",
      "type": "boolean",
      "text": "Is there a keynote speaker or guest of honour?",
      "why": "Adds keynote confirmation and protocol tasks.",
      "required": true,
      "when": []
    },
    {
      "key": "international.speakers",
      "type": "boolean",
      "text": "Will any speakers travel from abroad?",
      "why": "Adds travel, visa and accommodation tasks.",
      "required": true,
      "when": [
        {
          "key": "program.speakers",
          "op": "gte",
          "value": 1
        }
      ]
    },
    {
      "key": "venue.status",
      "type": "single_choice",
      "text": "Where does the venue booking stand?",
      "why": "Decides how urgent the venue tasks are.",
      "required": true,
      "when": [
        {
          "key": "event.venue_type",
          "op": "not_in",
          "values": ["online"]
        }
      ],
      "options": [
        {
          "value": "confirmed_in_writing",
          "label": "Confirmed in writing"
        },
        {
          "value": "requested",
          "label": "Requested, not confirmed"
        },
        {
          "value": "not_started",
          "label": "Not started"
        }
      ]
    },
    {
      "key": "online.platform",
      "type": "text",
      "text": "Which online or hybrid platform will you use?",
      "why": "Used to plan the technical rehearsal.",
      "required": false,
      "when": [
        {
          "key": "event.venue_type",
          "op": "in",
          "values": ["online", "hybrid"]
        }
      ],
      "maxLength": 100
    },
    {
      "key": "registration.ticketed",
      "type": "boolean",
      "text": "Will attendees pay or need a ticket?",
      "why": "Adds ticketing, payment and refund-policy tasks.",
      "required": true,
      "when": []
    },
    {
      "key": "catering.provided",
      "type": "boolean",
      "text": "Will you provide food and drink?",
      "why": "Adds catering tasks and budget lines.",
      "required": true,
      "when": []
    },
    {
      "key": "catering.dietary",
      "type": "multi_choice",
      "text": "Which dietary needs must the menu cover?",
      "why": "Goes into the catering brief.",
      "required": false,
      "when": [
        {
          "key": "catering.provided",
          "op": "equals",
          "value": true
        }
      ],
      "options": [
        {
          "value": "halal",
          "label": "Halal"
        },
        {
          "value": "vegetarian",
          "label": "Vegetarian"
        },
        {
          "value": "vegan",
          "label": "Vegan"
        },
        {
          "value": "gluten_free",
          "label": "Gluten free"
        },
        {
          "value": "nut_free",
          "label": "Nut free"
        }
      ]
    },
    {
      "key": "sponsors.expected",
      "type": "boolean",
      "text": "Do you expect sponsors?",
      "why": "Adds sponsor outreach and branding tasks.",
      "required": true,
      "when": []
    },
    {
      "key": "exhibition.booths",
      "type": "boolean",
      "text": "Will there be exhibition booths or a poster session?",
      "why": "Adds floor planning, power and booking tasks.",
      "required": true,
      "when": []
    },
    {
      "key": "media.recording",
      "type": "boolean",
      "text": "Will sessions be recorded or live-streamed?",
      "why": "Adds recording, release and storage tasks.",
      "required": true,
      "when": []
    },
    {
      "key": "media.consent",
      "type": "single_choice",
      "text": "How will you get speaker and attendee consent for recording?",
      "why": "Consent should be agreed before the event.",
      "required": true,
      "when": [
        {
          "key": "media.recording",
          "op": "equals",
          "value": true
        }
      ],
      "options": [
        {
          "value": "speaker_release",
          "label": "Speaker release form and a notice to attendees"
        },
        {
          "value": "registration_notice",
          "label": "Notice at registration only"
        },
        {
          "value": "not_decided",
          "label": "Not decided yet"
        }
      ]
    },
    {
      "key": "accessibility.ask_needs",
      "type": "boolean",
      "text": "Will you ask attendees about accessibility needs at registration?",
      "why": "Adds an accessibility support task.",
      "required": true,
      "when": []
    }
  ],
  "goals": [
    {
      "text": "Deliver a programme that attendees find relevant, on time and well hosted."
    },
    {
      "text": "Keep costs inside the budget and attendance close to the {{event.capacity}} you expect."
    },
    {
      "text": "Secure sponsors who help cover costs.",
      "when": [
        {
          "key": "sponsors.expected",
          "op": "equals",
          "value": true
        }
      ]
    },
    {
      "text": "Make speakers' travel and stay smooth.",
      "when": [
        {
          "key": "international.speakers",
          "op": "equals",
          "value": true
        }
      ]
    }
  ],
  "requirements": [
    {
      "text": "A programme with {{program.speakers}} speakers across {{program.tracks}}, published before registration closes."
    },
    {
      "text": "Rooms, seating and AV for about {{event.capacity}} people.",
      "when": [
        {
          "key": "event.venue_type",
          "op": "not_in",
          "values": ["online"]
        }
      ]
    },
    {
      "text": "A tested online or hybrid platform with a technical rehearsal.",
      "when": [
        {
          "key": "event.venue_type",
          "op": "in",
          "values": ["online", "hybrid"]
        }
      ]
    },
    {
      "text": "Ticketing with a clear price and refund policy.",
      "when": [
        {
          "key": "registration.ticketed",
          "op": "equals",
          "value": true
        }
      ]
    },
    {
      "text": "Recording consent agreed ({{media.consent}}) before any session is recorded.",
      "when": [
        {
          "key": "media.recording",
          "op": "equals",
          "value": true
        }
      ]
    },
    {
      "text": "A floor plan and power for exhibition booths.",
      "when": [
        {
          "key": "exhibition.booths",
          "op": "equals",
          "value": true
        }
      ]
    },
    {
      "text": "Food and drink covering: {{catering.dietary}}.",
      "when": [
        {
          "key": "catering.provided",
          "op": "equals",
          "value": true
        }
      ]
    },
    {
      "text": "Registration, name badges and a help desk."
    }
  ],
  "assumptions": [
    {
      "text": "The audience is a mixed group of professionals and students.",
      "ifMissing": "audience.kind"
    },
    {
      "text": "One main room with a single track.",
      "ifMissing": "program.tracks"
    },
    {
      "text": "The venue is not yet confirmed.",
      "ifMissing": "venue.status",
      "when": [
        {
          "key": "event.venue_type",
          "op": "not_in",
          "values": ["online"]
        }
      ]
    },
    {
      "text": "Speakers present in person and in English."
    }
  ],
  "decisions": [
    {
      "text": "Choose the theme and call for speakers."
    },
    {
      "text": "Decide whether attendance is paid.",
      "ifMissing": "registration.ticketed"
    },
    {
      "text": "Decide whether sessions will be recorded.",
      "ifMissing": "media.recording"
    }
  ],
