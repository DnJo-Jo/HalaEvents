  "riskCategories": [
    {
      "key": "venue",
      "label": "Venue and rooms",
      "description": "The venue isn't confirmed or doesn't fit the programme.",
      "when": [
        {
          "key": "event.venue_type",
          "op": "not_in",
          "values": ["online"]
        }
      ],
      "mitigation": "Confirm the rooms in writing and check capacity for each track.",
      "contingency": "Keep a backup venue or move low-attendance sessions online.",
      "likelihood": "medium",
      "elevatedWhen": [
        {
          "key": "venue.status",
          "op": "in",
          "values": ["requested", "not_started"]
        }
      ]
    },
    {
      "key": "speakers",
      "label": "Speaker drop-outs",
      "description": "A speaker cancels or can't travel.",
      "when": [
        {
          "key": "program.speakers",
          "op": "gte",
          "value": 1
        }
      ],
      "mitigation": "Confirm speakers in writing and keep a reserve list.",
      "contingency": "Keep a moderator-led panel ready to fill a gap.",
      "likelihood": "medium",
      "elevatedWhen": [
        {
          "key": "international.speakers",
          "op": "equals",
          "value": true
        }
      ]
    },
    {
      "key": "technology",
      "label": "Audio-visual and connectivity",
      "description": "Projectors, microphones, Wi-Fi or the stream fail.",
      "when": [],
      "mitigation": "Run a technical rehearsal in each room or on the platform.",
      "contingency": "Have spare microphones and a technician on call.",
      "likelihood": "medium",
      "elevatedWhen": [
        {
          "key": "program.tracks",
          "op": "gte",
          "value": 3
        }
      ]
    },
    {
      "key": "attendance",
      "label": "Attendance below or above plan",
      "description": "Fewer or more people than the {{event.capacity}} you plan for.",
      "when": [],
      "mitigation": "Track registrations weekly and adjust catering and rooms.",
      "contingency": "Agree the final catering numbers a few days before.",
      "likelihood": "medium",
      "elevatedWhen": []
    },
    {
      "key": "food",
      "label": "Food safety and dietary needs",
      "description": "Allergies and dietary requirements.",
      "when": [
        {
          "key": "catering.provided",
          "op": "equals",
          "value": true
        }
      ],
      "mitigation": "Ask about dietary needs at registration and label allergens.",
      "contingency": "Keep simple allergen-free options.",
      "likelihood": "low",
      "elevatedWhen": [
        {
          "key": "catering.dietary",
          "op": "includes",
          "value": "nut_free"
        }
      ]
    },
    {
      "key": "consent",
      "label": "Recording consent",
      "description": "Recording without proper agreement.",
      "when": [
        {
          "key": "media.recording",
          "op": "equals",
          "value": true
        }
      ],
      "mitigation": "Get speaker releases and show a notice to attendees.",
      "contingency": "Stop recording any session whose speaker has not agreed.",
      "likelihood": "medium",
      "elevatedWhen": [
        {
          "key": "media.consent",
          "op": "equals",
          "value": "not_decided"
        }
      ]
    },
    {
      "key": "finance",
      "label": "Budget",
      "description": "Costs grow faster than income.",
      "when": [],
      "mitigation": "Track spending against the budget each week.",
      "contingency": "Keep a reserve and a list of items to cut first.",
      "likelihood": "medium",
      "elevatedWhen": []
    }
  ],
