# HalaEvents — example environment. Copy to .env.local and fill in. NEVER commit real values.
# Variables prefixed NEXT_PUBLIC_ are shipped to the browser: never put secrets in them.

# --- App ---
NEXT_PUBLIC_APP_NAME=HalaEvents
# Used in auth email links (never derived from the request Host header). Must match Supabase
# Auth site_url / redirect allow-list.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (REQUIRED for sign-in; without it the app shows "Authentication isn't configured") ---
# Local CLI default shown; for a hosted project use https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Publishable key (or legacy anon key). Public by design; RLS protects data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (or legacy service-role key). SERVER ONLY, bypasses RLS. NOT used by the app at
# runtime (event.md §5.2); reserved for seeding/admin scripts. Leave empty unless you need it.
SUPABASE_SECRET_KEY=

# --- Email ---
# mock | resend
EMAIL_PROVIDER=mock
RESEND_API_KEY=
EMAIL_FROM=

# --- Weather (stretch) ---
# mock | open-meteo
WEATHER_PROVIDER=mock

# --- Venue discovery (stretch) ---
# mock | none | google
PLACES_PROVIDER=mock
GOOGLE_PLACES_API_KEY=
# Vendor discovery (Geoapify geocoding + places); server-side only.
GEOAPIFY_API_KEY=

# --- Custom plan drafts (optional; off by default) ---
# none | cloudflare. With "none" only template plans are offered.
AI_PROVIDER=none
# Server-only. Cloudflare dashboard: account id (32 hex chars) and an API token with Workers AI access.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Workers AI model id that supports JSON mode, e.g. @cf/meta/llama-3.3-70b-instruct-fp8-fast (check Cloudflare's model list).
AI_PLAN_MODEL=
# Limits (defaults shown): max output tokens per draft, max prompt characters, request timeout.
AI_PLAN_MAX_OUTPUT_TOKENS=4096
AI_MAX_INPUT_CHARS=14000
AI_TIMEOUT_MS=45000
# full = the model writes the whole custom draft (default); hybrid = budget, schedule and requirements from the playbook.
AI_PLAN_STRATEGY=full

# Gmail inbox agent (Google OAuth, server-only). Redirect URI: <NEXT_PUBLIC_APP_URL>/api/integrations/gmail/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# 32 random bytes, base64: openssl rand -base64 32
GMAIL_TOKEN_ENCRYPTION_KEY=
# Prototype: the one vendor address whose replies "Check for replies" reads
GMAIL_DEMO_VENDOR_EMAIL=
